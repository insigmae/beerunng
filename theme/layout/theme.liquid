{%- comment -%}
  Beerunng: an overlap. Ported from the Next.js store (store/). Brand: Pine Grove, Off-white, Matte Beige;
  Century Gothic Paneuropean (Jost where it isn't installed).
  Coming soon mode (Theme settings): every page shows the coming-soon page until launch.
{%- endcomment -%}
{%- if settings.coming_soon and request.design_mode == false -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
{% render 'coming-soon-head' %}
<link rel="canonical" href="{{ shop.url }}">
{{ content_for_header }}
</head>
<body>
{% section 'coming-soon' %}
</body>
</html>
{%- else -%}
{%- comment -%}
  Type matches the Vercel store exactly: its pages render in Jost (next/font's class wins over the brand stack, even
  where Century Gothic is installed), so the page font here is Jost too. Century Gothic is wider with a taller x-height,
  which made the theme look zoomed in next to Vercel. The 3D intro keeps Vercel's own font list for its carved letters.
{%- endcomment -%}
{%- assign font = 'Jost, sans-serif' -%}
{%- assign intro_font = '"Century Gothic Paneuropean", "Century Gothic", CenturyGothic, Jost, sans-serif' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" style="--font: {{ font | escape }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#223631">
<title>{% if template.name == 'index' %}Beerunng — an overlap.{% else %}{{ page_title }}{% unless page_title contains shop.name %} — Beerunng{% endunless %}{% endif %}</title>
<meta name="description" content="{{ page_description | default: 'Beerunng exists in the space between what we inherit and what we become.' | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;700&display=swap" rel="stylesheet">
{{ 'beerunng.css' | asset_url | stylesheet_tag }}
<script>
  // Shared with the scripts: asset URLs live on Shopify's CDN, so they're handed over here.
  window.BEERUNNG = {
    font: {{ intro_font | json }},
    mark: {{ 'mark-three.png' | asset_url | json }},
    drape: {{ 'drape.jpg' | asset_url | json }},
    root: {{ routes.root_url | json }},
    cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
    cartChange: {{ routes.cart_change_url | append: '.js' | json }},
    cart: {{ routes.cart_url | append: '.js' | json }},
    checkout: '/checkout'
  };
  {%- if template.name == 'index' %}
  // The opening plays once per visit, as its own layer over the homepage. Decided before anything is painted:
  // skip it if it already played, on ?skip-intro, or for reduced motion; ?intro replays it. Only then is the
  // (larger) 3D intro script loaded at all.
  try {
    var q = location.search;
    if (!/[?&]intro\b/.test(q) && (sessionStorage.getItem('beerunng-intro') === '1' || /[?&]skip-intro\b/.test(q) ||
        matchMedia('(prefers-reduced-motion: reduce)').matches || {{ request.design_mode }})) {
      document.documentElement.classList.add('intro-seen');
    } else {
      var s = document.createElement('script');
      s.src = {{ 'beerunng-intro.js' | asset_url | json }};
      s.defer = true;
      document.head.appendChild(s);
    }
  } catch (e) { document.documentElement.classList.add('intro-seen'); }
  {%- else %}
  document.documentElement.classList.add('intro-seen');
  {%- endif %}
</script>
<script src="{{ 'beerunng.js' | asset_url }}" defer></script>
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  {% sections 'header-group' %}
  {%- if template.name == 'index' %}{% render 'ladder' %}{% endif %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'bag' %}
  <div class="cursor" aria-hidden="true"><span class="cur cur-warm"></span><span class="cur cur-cool"></span></div>
</body>
</html>
{%- endif -%}
