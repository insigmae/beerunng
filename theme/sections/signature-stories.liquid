{%- comment -%}
  01: what you carry. The signature pieces, told as the people who wear them. Each chapter is a block: pick the
  product, write the lines (one per line). The product name is the biggest type; the story beneath it is quiet,
  and each line lights up as you read past it (src/home.ts).
{%- endcomment -%}
<section id="carry" class="stories" data-rung="01">
  <header class="stories-head">
    <span class="caps"><span class="sq">■</span>01 / {{ section.settings.label }}</span>
    <h2 data-rise>{{ section.settings.heading }}</h2>
    <p data-rise>{{ section.settings.intro }}</p>
  </header>

  {%- for block in section.blocks -%}
    {%- assign p = block.settings.product -%}
    <article class="chapter{% cycle '', ' flip' %}" {{ block.shopify_attributes }}>
      <div class="chapter-photo">
        {%- if block.settings.image -%}
          {%- assign focus = block.settings.crop | prepend: 'object-position: ' -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: alt: block.settings.title, style: focus, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}, from the Beerunng lookbook" style="object-position: {{ block.settings.crop }}" loading="lazy" width="2262" height="1600">
        {%- endif -%}
      </div>
      <div class="chapter-copy">
        <span class="caps muted">Signature piece 0{{ forloop.index }}</span>
        <h3 class="chapter-name" data-rise>{{ p.title | default: block.settings.title }}</h3>
        <div class="chapter-lines">
          {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign l = line | strip -%}
            {%- if l != blank %}<p class="line">{{ l }}</p>{% endif -%}
          {%- endfor -%}
          <p class="line chapter-close">{{ block.settings.close }}</p>
        </div>
        <div class="chapter-buy">
          {%- if p != blank -%}
            <div class="chapter-price">
              {%- capture c %}{% render 'colour', product: p %}{% endcapture -%}
              <span class="caps muted">{{ p.type }}{% if c != blank %} · {{ c }}{% endif %}</span>
              <span>{% render 'price', amount: p.price %}</span>
            </div>
            {% render 'quick-add', product: p %}
            <a href="{{ p.url }}" class="caps cta"><span class="cta-line"></span>See the piece</a>
          {%- else -%}
            <p class="caps muted">Pick this piece's product in the theme editor to sell it here.</p>
          {%- endif -%}
        </div>
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "What you carry",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "What you carry" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do you carry?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Everyone carries two things: what they were given, and what they chose. These are the two pieces people come back to." }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Signature piece",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Name (used until a product is picked)" },
        { "type": "image_picker", "id": "image", "label": "Campaign image" },
        { "type": "text", "id": "fallback", "label": "Built-in image (when no campaign image)", "default": "deck-third-rung.jpg" },
        { "type": "text", "id": "crop", "label": "Image focus (x% y%)", "default": "50% 50%" },
        { "type": "textarea", "id": "lines", "label": "Story lines (one per line)" },
        { "type": "text", "id": "close", "label": "Closing line (bold)" }
      ]
    }
  ],
  "presets": [{ "name": "What you carry" }]
}
{% endschema %}
