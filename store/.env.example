# Shopify (headless). From Shopify admin: Sales channels > Headless > your storefront > Storefront API.
# Put the real values in .env.local (never committed) and in Vercel > beerunng-store > Settings > Environment Variables.
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Optional: Storefront API version (defaults to 2026-10)
# SHOPIFY_API_VERSION=2026-10
