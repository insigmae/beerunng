{%- paginate collection.products by 24 -%}
<h1>{{ collection.title }}</h1>
<div class="grid">
  {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- else -%}<p>Nothing here yet.</p>{%- endfor -%}
</div>
{%- if paginate.pages > 1 -%}<p class="caps">{{ paginate | default_pagination }}</p>{%- endif -%}
{%- endpaginate -%}
